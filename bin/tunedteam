#!/usr/bin/env python3
"""Tuned Team: a multi-agent dev environment for Claude Code, in tmux.

The owner runs only `tunedteam` in a project folder: a few questions, then one
tmux session opens with a tab per agent. You talk to the director; the director hands
tasks to the specialists, who do the work. The other commands are for the agents.

  tunedteam                            ask, then start the team for this folder (last tab: your own shell)
  tunedteam --version                  the installed version
  tunedteam --inside-out               how it works under the hood and why (context, tmux, accounts)
  tunedteam status                     team table: who works, who waits for the owner, context
  tunedteam teams                      the teams running on this Mac and their directors' addresses
  tunedteam tasks                      the tasks in progress and the specialists on each
  tunedteam schedule [add NAME HH:MM CMD | run|log|off|on|rm NAME]  commands run every day by launchd
  tunedteam report start|eta|done ...  a specialist writes its state into the table
  tunedteam worktree BRANCH [BASE]      new branch + worktree next to the repo, hidden from Spotlight
  tunedteam check [--timeout S] CMD..  run the full check once one of the 2 machine slots is free
  tunedteam done                       task merged, worktree and branch gone: restart this window fresh
  tunedteam add                        open one more specialist
  tunedteam restart NAME               restart a window with a fresh context
  tunedteam close-all [--force]        close every window (lists unmerged work first)
  tunedteam statusline                 Claude Code status line (JSON on stdin)
  tunedteam speak                      Claude Code hook: reads <speak> text or a wait aloud
"""
import glob, json, os, re, shlex, shutil, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ROLES = os.path.join(ROOT, 'roles')
# Tests set TUNED_TMUX_SOCKET to their own server, so they never touch the owner's running teams.
TMUX = ['tmux', '-L', os.environ.get('TUNED_TMUX_SOCKET', 'tuned'), '-f', os.path.join(ROOT, 'tmux.conf')]
HOME = os.path.expanduser('~')
CLAUDE_DIR = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.join(HOME, '.claude')
CHECK_SLOTS = int(os.environ.get('TUNED_CHECK_MAX', 2))
CHECK_PATTERN = os.environ.get('TUNED_CHECK_PATTERN', 'npm run check')

CONTROL = {
    'owner': "Control mode for this project: THE OWNER DECIDES. Release, push, deploy and changes to settings or "
             "permissions wait for a yes from the owner, given after you show the exact repo, branch and commits. "
             "The owner pushes by hand: give them the exact command.",
    'team': "Control mode for this project: THE TEAM DECIDES. The director releases on its own, at most once an hour: "
            "it collects the commits merged since the last release and ships them in one release (every release is a "
            "deploy, and each deploy fills the hosting's storage). The team decides each step itself. Permission prompts "
            "and sandbox blocks still go to the owner.",
}
SPEAK = {
    'all': "Reading aloud is ON for everything: end each reply to the owner with <speak>1-2 plain spoken sentences: "
           "what happened or what you need</speak>. Put only plain words inside it.",
    'questions': "Reading aloud is ON for questions only: when you ask the owner something or something is stuck "
                 "(a permission, a failing check), end the reply with <speak>1-2 plain spoken sentences</speak>. "
                 "Keep status replies in plain text. Put only plain words inside the tag.",
    'off': "Reading aloud is OFF: reply in plain text only.",
}
# Database and deploy tools through MCP. "ask" puts every tool that writes, migrates, deploys or deletes
# on Claude Code's ask list (it holds in auto mode too, tested), so the owner approves each call.
DB_WRITE_TOOLS = ['mcp__*__execute_*', 'mcp__*__apply_*', 'mcp__*__run_sql*', 'mcp__*__deploy_*', 'mcp__*__delete_*',
                  'mcp__*__drop_*', 'mcp__*__insert_*', 'mcp__*__merge_branch', 'mcp__*__reset_branch',
                  'mcp__*__rebase_branch', 'mcp__*__create_edge_function_secret']
DB = {
    'ask': "Database and deploy tools: read freely. Before any write, migration, deploy or delete, save the change "
           "as a file in the repo (e.g. a SQL migration), show the owner the exact SQL or command, and run it after "
           "their yes; Claude Code asks the owner for each such tool call.",
    'full': "Database and deploy tools: full rights. Run writes, migrations and deploys yourself, saving each "
            "schema change as a migration file in the repo.",
}
LANGUAGE = ("Language: reply to the owner in the language the owner writes in. "
            "Write to teammates in English.")
WAIT = '{name} is waiting for you'
POLISH = re.compile('[ąćęłńóśźżĄĆĘŁŃÓŚŹŻ]')


def version():
    """VERSION from the release; in a git checkout also how far the code is past that release."""
    try:
        v = open(os.path.join(ROOT, 'VERSION')).read().strip()
    except OSError:
        v = '?'
    if os.path.isdir(os.path.join(ROOT, '.git')):
        desc = run(['git', '-C', ROOT, 'describe', '--tags', '--dirty']).stdout.strip()
        if desc and desc != f'v{v}':
            return f'{v} (dev: {desc})'
    return v


def update_notice():
    """Once a day: the newest vX.Y.Z tag on GitHub; a line saying how to update when it is newer."""
    import urllib.request
    path = os.path.join(HOME, '.tunedteam', 'update-check.json')
    seen = read_json(path, {})
    if time.time() - seen.get('at', 0) > 86400:
        try:
            with urllib.request.urlopen('https://api.github.com/repos/zdzislawbela/tunedteam/tags?per_page=100',
                                        timeout=2) as r:
                tags = [t['name'][1:] for t in json.load(r) if re.fullmatch(r'v\d+\.\d+\.\d+', t['name'])]
            seen = {'at': time.time(), 'latest': max(tags, key=lambda t: tuple(map(int, t.split('.'))), default='')}
            os.makedirs(os.path.dirname(path), exist_ok=True)
            write_json(path, seen)
        except Exception:
            return ''  # offline or rate-limited: say nothing
    latest = seen.get('latest', '')
    try:
        mine = open(os.path.join(ROOT, 'VERSION')).read().strip()
        newer = tuple(map(int, latest.split('.'))) > tuple(map(int, mine.split('.')))
    except (OSError, ValueError):
        return ''
    if not newer:
        return ''
    how = ('brew upgrade tunedteam' if '/Cellar/' in ROOT
           else f'git -C {shlex.quote(ROOT)} pull --ff-only && {shlex.quote(ROOT)}/install.sh')
    return f'Update available: {mine} -> {latest}. Run: {how}'


def voice(text):
    """A Polish voice for Polish text (its letters give it away), the system voice otherwise."""
    return ['-v', 'Zosia'] if POLISH.search(text) else []


# ---------- small helpers ----------

def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def tmux(*args):
    return run(TMUX + list(args))


def repo_root(path):
    """The repo's main checkout (the same for every worktree), or the folder itself outside git."""
    out = run(['git', '-C', path, 'rev-parse', '--path-format=absolute', '--git-common-dir']).stdout.strip()
    return os.path.dirname(os.path.realpath(out)) if out else os.path.realpath(path)


def team_name(path=None):
    if os.environ.get('TUNED_TEAM') and path is None:
        return os.environ['TUNED_TEAM']
    return re.sub(r'[^A-Za-z0-9_-]', '-', os.path.basename(repo_root(path or os.getcwd())))


def unique_team(path):
    """The folder's name, plus -2, -3… when another project folder of the same name already has that team."""
    root = repo_root(path)
    base = team_name(path)
    for k in range(1, 100):
        team = base if k == 1 else f'{base}-{k}'
        cwd = read_json(os.path.join(HOME, '.tunedteam', 'teams', team, 'config.json'), {}).get('cwd')
        if not cwd or not os.path.isdir(cwd) or os.path.realpath(cwd) == root:
            return team
    sys.exit(f'Too many projects named {base}.')


def address(team, name):
    """The agent's name on this Mac (SendMessage, ListAgents): unique across teams, e.g. myapp.specialist-3."""
    return f'{team}.{name}'


def state_dir(team):
    old, new = os.path.join(HOME, '.tuned-team'), os.path.join(HOME, '.tunedteam')
    if os.path.isdir(old) and not os.path.exists(new):
        os.rename(old, new)  # the state folder of versions before the rename
    d = os.path.join(new, 'teams', team)
    os.makedirs(d, exist_ok=True)
    return d


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def write_json(path, data):
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def config(team):
    return read_json(os.path.join(state_dir(team), 'config.json'), {})


def windows(team):
    """[(index, name, pane_pid)] of the team's tmux session."""
    out = tmux('list-panes', '-s', '-t', f'={team}', '-F', '#{window_index}\t#{window_name}\t#{pane_pid}').stdout
    return [(int(i), n, int(p)) for i, n, p in (l.split('\t') for l in out.splitlines() if l.count('\t') == 2)]


def numbers(team, role):
    return sorted(int(m.group(1)) for _, n, _ in windows(team) if (m := re.fullmatch(rf'{role}-(\d+)', n)))


def me():
    name = os.environ.get('TUNED_NAME')
    if not name:
        sys.exit('Run this inside a Tuned Team window (TUNED_NAME is not set).')
    return name


# ---------- prompts and launching ----------

def handover_path(team):
    return os.path.join(state_dir(team), 'handover.md')


def team_lines(name, cfg, team):
    """Which team this window is in and who it works with, from the windows that are open now."""
    specs = numbers(team, 'specialist') or list(range(1, cfg['specialists'] + 1))
    mates = [address(team, n) for n in ['director'] + [f'specialist-{k}' for k in specs] if n != name]
    out = (f"Your team: {team} (project {cfg['cwd']}). You are {address(team, name)}. "
           f"Your teammates: {', '.join(mates)}.")
    if name == 'director':
        return out + f' Your handover file: {handover_path(team)}'
    return out + ' Tasks come from the director.'


def prompt_file(team, name, cfg):
    role = 'specialist' if name.startswith('specialist-') else 'director'
    parts = [open(os.path.join(ROLES, 'team.md')).read(), open(os.path.join(ROLES, f'{role}.md')).read(),
             team_lines(name, cfg, team),
             LANGUAGE,
             CONTROL[cfg['control']],
             DB[cfg.get('db', 'ask')]]
    if role == 'director':
        parts.append(SPEAK[cfg['speak']])
    path = os.path.join(state_dir(team), 'prompts', f'{name}.md')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write('\n\n'.join(parts) + '\n')
    return path


def settings_file(team, name, cfg):
    """Per-window Claude Code settings, layered on top of the user's own (claude --settings)."""
    me_cmd = shlex.quote(os.path.realpath(__file__))
    s = {'statusLine': {'type': 'command', 'command': f'{me_cmd} statusline'}, 'hooks': {}}
    if name == 'director':
        # The team counts change while the director sits idle: redraw every 15 s (as long as they are cached).
        s['statusLine']['refreshInterval'] = 15
    if cfg.get('db', 'ask') == 'ask':
        s['permissions'] = {'ask': DB_WRITE_TOOLS}
    if name == 'director' and cfg['speak'] != 'off':
        s['hooks']['Stop'] = [{'hooks': [{'type': 'command', 'command': f'{me_cmd} speak'}]}]
    if cfg['speak'] == 'all':
        s['hooks']['Notification'] = [{'hooks': [{'type': 'command', 'command': f'{me_cmd} speak'}]}]
    path = os.path.join(state_dir(team), 'settings', f'{name}.json')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_json(path, s)
    return path


def launch(team, name, cfg, first=''):
    """tmux args (env + command) that start one agent's claude."""
    model = 'opus' if name == 'director' else cfg['model']
    # The account comes from CLAUDE_CONFIG_DIR. Without it, clear it explicitly: the tmux server keeps the
    # environment of the shell that first started it, which may belong to the other account.
    prefix = [] if os.environ.get('CLAUDE_CONFIG_DIR') else ['env', '-u', 'CLAUDE_CONFIG_DIR']
    # On a subscription, windows run without the paid API key: Claude Code then uses the plan, and the
    # agents' commands cannot pick the key up from the environment.
    if cfg.get('subscription', True):
        prefix = (prefix or ['env']) + ['-u', 'ANTHROPIC_API_KEY']
    cmd = prefix + ['claude', '-n', address(team, name), '--model', model, '--permission-mode', 'auto',
           '--settings', settings_file(team, name, cfg),
           '--append-system-prompt-file', prompt_file(team, name, cfg)]
    if first:
        cmd.append(first)
    env = {'TUNED_TEAM': team, 'TUNED_NAME': name}
    if os.environ.get('CLAUDE_CONFIG_DIR'):
        env['CLAUDE_CONFIG_DIR'] = os.environ['CLAUDE_CONFIG_DIR']
    args = []
    for k, v in env.items():
        args += ['-e', f'{k}={v}']
    return args, shlex.join(cmd)


def first_message(name, cfg, restarted=False):
    if name == 'director':
        if restarted:
            return ('You were restarted with a fresh context. Read your handover file, run `tunedteam status`, '
                    'then continue where the handover says.')
        return (f"start. Team: {cfg['specialists']} specialist(s). "
                'Tell the owner who is on the team, the control mode, and that you are ready for a task.')
    return ''


def open_window(team, name, cfg):
    env, cmd = launch(team, name, cfg, first_message(name, cfg))
    tmux('new-window', '-d', '-t', f'={team}:', '-n', name, '-c', cfg['cwd'], *env, cmd)


# ---------- the owner's command: ask, then start ----------

def select(question, options, default=None):
    """Pick one option with the arrow keys and Enter. options: [(value, label)]; returns the value.
    Without a terminal (a pipe, a script) it reads one line: a number, a value, or Enter for the default."""
    values = [v for v, _ in options]
    i = values.index(default) if default in values else 0
    if not sys.stdin.isatty():
        a = sys.stdin.readline().strip()
        if a.isdigit() and 1 <= int(a) <= len(options):
            return values[int(a) - 1]
        return next((v for v in values if str(v) == a), values[i])
    import termios, tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    print(question)
    sys.stdout.write('\033[?25l')  # hide the cursor while choosing
    def draw(first=False):
        if not first:
            sys.stdout.write(f'\033[{len(options)}A')
        for k, (_, label) in enumerate(options):
            sys.stdout.write('\r\033[2K' + (f'  \033[1m> {label}\033[0m' if k == i else f'    {label}') + '\n')
        sys.stdout.flush()
    try:
        tty.setcbreak(fd)
        draw(True)
        while True:
            c = os.read(fd, 1)
            if not c:
                break  # end of input: keep the highlighted option
            if c == b'\x1b':
                c += os.read(fd, 2)  # an arrow key: ESC [ A/B
            if c in (b'\r', b'\n'):
                break
            if c in (b'\x1b[A', b'k'):
                i = (i - 1) % len(options)
            elif c in (b'\x1b[B', b'j'):
                i = (i + 1) % len(options)
            elif c in (b'\x03', b'q'):
                raise KeyboardInterrupt
            draw()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write('\033[?25h')
    sys.stdout.write(f'\033[{len(options)}A\033[J  {options[i][1]}\n')
    return values[i]


def auth_status(config_dir):
    """`claude auth status` for one account (config folder; None = the default ~/.claude)."""
    env = dict(os.environ)
    env.pop('CLAUDE_CONFIG_DIR', None)
    env.pop('ANTHROPIC_API_KEY', None)  # with a key in env, status reports the key, not the subscription
    if config_dir:
        env['CLAUDE_CONFIG_DIR'] = config_dir
    try:
        return json.loads(run(['claude', 'auth', 'status', '--json'], env=env).stdout or '{}')
    except Exception:
        return {}


def accounts():
    """[(config_dir or None, label)] of the Claude accounts on this Mac: ~/.claude plus every ~/.claude-*."""
    dirs = [None] + sorted(d.rstrip('/') for d in glob.glob(os.path.join(HOME, '.claude-*/'))
                           if os.path.exists(os.path.join(d, '.claude.json')))
    # A CLAUDE_CONFIG_DIR somewhere else (e.g. ~/work/claude) is an account too.
    own = os.environ.get('CLAUDE_CONFIG_DIR')
    if own and os.path.realpath(own) not in [os.path.realpath(d) for d in dirs if d]:
        dirs.append(own.rstrip('/'))
    out = []
    for d in dirs:
        st = auth_status(d)
        plan = st.get('subscriptionType') or st.get('authMethod', '?')
        who = f"{st.get('email') or 'API key'}, {plan}" if st.get('loggedIn') else 'not logged in'
        out.append((d, f"{who} ({(d or os.path.join(HOME, '.claude')).replace(HOME, '~')})"))
    return out


def use_account(config_dir):
    """Point this process (and so every window it opens) at one account."""
    global CLAUDE_DIR
    if config_dir:
        os.environ['CLAUDE_CONFIG_DIR'] = config_dir
    else:
        os.environ.pop('CLAUDE_CONFIG_DIR', None)
    CLAUDE_DIR = config_dir or os.path.join(HOME, '.claude')


def choose_account(last):
    """Ask which account to use and make sure it is logged in before any window opens."""
    accs = accounts()
    current = last.get('account', os.environ.get('CLAUDE_CONFIG_DIR'))
    d = accs[0][0] if len(accs) == 1 else select('Claude account:', accs, current)
    use_account(d)
    if not auth_status(d).get('loggedIn'):
        print('This account is not logged in. Logging in now (a browser opens).')
        subprocess.run(['claude', 'auth', 'login'])
        if not auth_status(d).get('loggedIn'):
            sys.exit('Still not logged in; nothing opened. Run tunedteam again after logging in.')
    st = auth_status(d)
    print(f"Using {st.get('email') or 'API key'} ({st.get('subscriptionType') or st.get('authMethod', '?')}).")
    return d, bool(st.get('subscriptionType'))


def api_key_warning(cwd, subscription):
    """Say where a paid Anthropic API key could leak into the agents' work."""
    found = ['your shell environment'] if os.environ.get('ANTHROPIC_API_KEY') else []
    for f in sorted(glob.glob(os.path.join(cwd, '.env*'))):
        if re.search(r'\.(example|sample|template)$', f):
            continue  # templates hold placeholders, not keys
        try:
            if re.search(r'^\s*(export\s+)?ANTHROPIC_API_KEY\s*=\s*\S', open(f).read(), re.M):
                found.append(os.path.basename(f))
        except OSError:
            pass
    if found and not subscription:  # on a plan the windows start without the key: nothing to say
        print(f"This account has no subscription: the agents run on the API key from {', '.join(found)} and it costs money.")


def is_repo(path):
    return run(['git', '-C', path, 'rev-parse', '--git-dir']).returncode == 0


def choose_folder():
    """First question: which project. Current folder (if a repo), recent teams, repos in ~/repos, or a typed path."""
    here = os.getcwd()
    recent = []
    for f in glob.glob(os.path.join(HOME, '.tunedteam', 'teams', '*', 'config.json')):
        cwd = read_json(f, {}).get('cwd')
        if cwd and os.path.isdir(cwd):
            recent.append((os.path.getmtime(f), cwd))
    recent = [c for _, c in sorted(recent, reverse=True)]
    found = sorted(os.path.dirname(g) for g in glob.glob(os.path.join(HOME, 'repos', '*', '.git'))
                   + glob.glob(os.path.join(HOME, 'repos', '*', '*', '.git')))
    found = [d for d in found if '.noindex' not in d and not re.search(r'-check-\d+$', d)]
    paths = []
    for d in ([here] if is_repo(here) else []) + recent + found:
        d = repo_root(d)
        if d not in paths:
            paths.append(d)
    paths = paths[:20]
    other = '__other__'
    pick = select('Project folder:', [(d, d.replace(HOME, '~')) for d in paths] + [(other, 'Other folder…')])
    if pick == other:
        typed = os.path.expanduser(input('Folder: ').strip())
        if not os.path.isdir(typed):
            sys.exit(f'No such folder: {typed}')
        pick = typed
    os.chdir(pick)
    return pick


def trusted(path):
    """Claude Code asked once whether to trust this folder (or a parent) and got a yes."""
    cfg = os.path.join(CLAUDE_DIR, '.claude.json') if os.environ.get('CLAUDE_CONFIG_DIR') else os.path.join(HOME, '.claude.json')
    projects = read_json(cfg, {}).get('projects', {})
    p = os.path.realpath(path)
    while True:
        if projects.get(p, {}).get('hasTrustDialogAccepted'):
            return True
        if p == os.path.dirname(p):
            return False
        p = os.path.dirname(p)


def start():
    print(f'Tuned Team {version()}. Arrows to choose, Enter to confirm.')
    notice = update_notice()
    if notice:
        print(notice)
    choose_folder()
    iterm_setup()
    claude_update_setup()
    team = unique_team(os.getcwd())
    if tmux('has-session', '-t', f'={team}').returncode == 0:
        print(f'Team "{team}" is already running; attaching.')
        return attach(team)
    last = config(team)
    account, subscription = choose_account(last)
    api_key_warning(os.getcwd(), subscription)
    if not trusted(os.getcwd()):
        sys.exit('Claude Code does not trust this folder yet on this account, and every window would ask. '
                 'Run `claude` here once, answer "Yes, I trust this folder", exit, then run tunedteam again.')
    specialists = select('Specialists:', [(n, str(n)) for n in (1, 2, 3, 4, 6, 8, 12, 16)], 16)
    model = select('Model for the specialists (the director always runs on Opus):',
                   [('opus', 'Opus'), ('sonnet', 'Sonnet (uses less of your plan)')], last.get('model', 'opus'))
    # The safe answer is always the default here, whatever was picked last time.
    control = select('Push, release and deploy:', [('owner', 'you decide'), ('team', 'the team decides')], 'owner')
    db = select('Database and deploy writes through MCP:',
                [('ask', 'ask you each time'), ('full', 'full rights (staging databases only)')], 'ask')
    speak = select('Read aloud:', [('off', 'off'), ('questions', 'only questions for you'), ('all', 'everything')],
                   last.get('speak', 'questions'))
    cfg = dict(account=account, subscription=subscription, specialists=specialists, model=model, control=control, db=db, speak=speak,
               cwd=os.getcwd())
    write_json(os.path.join(state_dir(team), 'config.json'), cfg)
    write_json(os.path.join(state_dir(team), 'reports.json'), {})

    env, cmd = launch(team, 'director', cfg, first_message('director', cfg))
    r = tmux('new-session', '-d', '-s', team, '-n', 'director', '-c', cfg['cwd'], *env, cmd)
    if r.returncode:
        sys.exit(f'tmux could not start: {r.stderr.strip()}')
    print(f'Opening the director and {specialists} specialist(s)...')
    for k in range(1, specialists + 1):
        open_window(team, f'specialist-{k}', cfg)
        time.sleep(0.3)  # 100 claudes starting in the same second choke the machine
    lazygit = shutil.which('lazygit')
    if lazygit:  # the repo in lazygit, a tab of its own
        tmux('new-window', '-d', '-t', f'={team}:', '-n', 'lazygit', '-c', cfg['cwd'], lazygit)
    for name, command in own_tabs():
        # A plain shell with the command typed in, so the owner's aliases work and Ctrl-C leaves the shell.
        tmux('new-window', '-d', '-t', f'={team}:', '-n', name, '-c', cfg['cwd'])
        tmux('send-keys', '-t', f'={team}:={name}', command, 'Enter')
    # The owner's own plain terminal in the project folder, the last tab.
    tmux('new-window', '-d', '-t', f'={team}:', '-n', 'shell', '-c', cfg['cwd'])
    attach(team)


def own_tabs():
    """The owner's extra tabs from ~/.tunedteam/tabs, one per line: "name: command" (e.g. "awake: caffeinate -d")."""
    try:
        lines = open(os.path.join(HOME, '.tunedteam', 'tabs')).read().splitlines()
    except OSError:
        return []
    tabs = [[s.strip() for s in l.split(':', 1)] for l in lines if ':' in l and not l.lstrip().startswith('#')]
    return [(re.sub(r'[^A-Za-z0-9_-]', '-', n), c) for n, c in tabs if n and c]


def attach(team):
    tmux('select-window', '-t', f'={team}:=director')
    if not sys.stdout.isatty() or os.environ.get('TUNED_NO_ATTACH'):
        return print(f'Team {team} is running: {shlex.join(TMUX + ["attach-session", "-t", team])}')
    if os.environ.get('TMUX'):
        os.execvp(TMUX[0], TMUX + ['switch-client', '-t', f'={team}'])
    if os.environ.get('TERM_PROGRAM') == 'iTerm.app':
        if iterm_tmux_tabs():
            # iTerm2's tmux integration: every agent becomes a native iTerm2 tab (tab bar can sit on the left).
            os.execvp(TMUX[0], TMUX + ['-CC', 'attach-session', '-t', f'={team}'])
    os.execvp(TMUX[0], TMUX + ['attach-session', '-t', f'={team}'])


def iterm_tmux_tabs():
    """True when iTerm2 opens tmux windows as tabs. Unset (0, its default) means one iTerm2 window per agent."""
    if ITERM_JUST_SET:
        return False  # a running iTerm2 may not have read the new settings yet: tabs from the next start
    value = run(['defaults', 'read', 'com.googlecode.iterm2', 'OpenTmuxWindowsIn']).stdout.strip()
    return value not in ('', '0')


ITERM_JUST_SET = False
# iTerm2 settings keys: tmux windows as tabs in the attaching window, tab bar on the left,
# the tmux gateway tab hidden. Read from iTerm2's own plist after setting them in its Settings.
ITERM_TABS = {'OpenTmuxWindowsIn': 2, 'AutoHideTmuxClientSession': True}
ITERM_SIDEBAR = {**ITERM_TABS, 'TabViewType': 2}


def iterm_setup():
    """In iTerm2, once: offer the tunedteam layout (every agent a native tab). Asks only while iTerm2 still opens
    tmux windows as separate windows, and never again after "leave it"."""
    global ITERM_JUST_SET
    path = os.path.join(HOME, '.tunedteam', 'iterm.json')
    if os.environ.get('TERM_PROGRAM') != 'iTerm.app' or iterm_tmux_tabs() or read_json(path, {}).get('declined'):
        return
    pick = select('iTerm2 layout:', [('sidebar', 'tunedteam setup: agents as a list on the left'),
                                     ('tabs', 'agents as tabs on top'),
                                     ('no', 'leave iTerm2 as it is (tmux tab bar at the bottom)')], 'sidebar')
    if pick == 'no':
        os.makedirs(os.path.dirname(path), exist_ok=True)
        return write_json(path, {'declined': True})
    for key, value in (ITERM_SIDEBAR if pick == 'sidebar' else ITERM_TABS).items():
        kind = ['-bool', 'true' if value else 'false'] if isinstance(value, bool) else ['-int', str(value)]
        run(['defaults', 'write', 'com.googlecode.iterm2', key, *kind])
    ITERM_JUST_SET = True
    print('iTerm2 is set. This start uses the tmux tab bar; from the next start (or after restarting iTerm2) '
          'every agent is an iTerm2 tab.')


# ---------- agents' commands ----------

def add():
    team = team_name()
    cfg = config(team)
    name = f'specialist-{max(numbers(team, "specialist") or [0]) + 1}'
    open_window(team, name, cfg)
    print(f'Opened {name}.')


def restart(name):
    team = team_name()
    cfg = config(team)
    if name in ('self', os.environ.get('TUNED_NAME')):
        name = me()
        delay = 8  # let this reply finish before the window starts over
    else:
        delay = 0
    if name not in [n for _, n, _ in windows(team)]:
        sys.exit(f'No window "{name}" in team {team}.')
    reports = read_json(os.path.join(state_dir(team), 'reports.json'), {})
    reports.pop(name, None)
    write_json(os.path.join(state_dir(team), 'reports.json'), reports)
    env, cmd = launch(team, name, cfg, first_message(name, cfg, restarted=True))
    # respawn-pane, not respawn-window: respawn-window makes the window the session's current one, and iTerm2
    # (tmux -CC) then jumps to that tab while the owner is typing to the director.
    respawn = shlex.join(TMUX + ['respawn-pane', '-k', '-t', f'={team}:={name}', '-c', cfg['cwd'], *env, cmd])
    tmux('run-shell', '-b', f'sleep {delay}; {respawn}')
    print(f'{name} restarts with a fresh context' + (f' in {delay} s.' if delay else '.'))


def done():
    """Task merged, worktree and branch removed: the window starts over with a fresh context.
    Refuses while the worktree or an unmerged branch from `tunedteam worktree` is still there."""
    name, team = me(), team_name()
    r = read_json(os.path.join(state_dir(team), 'reports.json'), {}).get(name, {})
    left = []
    if r.get('worktree') and os.path.isdir(r['worktree']):
        left.append(f"worktree {r['worktree']} (remove it: git worktree remove {r['worktree']})")
    if r.get('branch'):
        top = repo_root(os.getcwd())
        if run(['git', '-C', top, 'rev-parse', '--verify', '--quiet', f"refs/heads/{r['branch']}"]).returncode == 0:
            left.append(f"branch {r['branch']} (merge it, then delete it: git branch -d {r['branch']})")
    if left:
        sys.exit('Still open, the window keeps its context:\n' + '\n'.join(f'  - {x}' for x in left))
    report(['done'])
    restart('self')


def worktree(args):
    """New branch + worktree in <repo>-worktrees.noindex/ next to the repo (Spotlight skips .noindex folders).
    node_modules is cloned (APFS clone: seconds, no extra disk) and .env.local copied, if the repo has them."""
    if not args:
        sys.exit('Usage: tunedteam worktree <branch> [base]')
    branch = args[0]
    top = repo_root(os.getcwd())
    base = args[1] if len(args) > 1 else (
        run(['git', '-C', top, 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD']).stdout.strip().removeprefix('origin/')
        or run(['git', '-C', top, 'branch', '--show-current']).stdout.strip())
    path = os.path.join(os.path.dirname(top), f'{os.path.basename(top)}-worktrees.noindex', branch.replace('/', '-'))
    r = run(['git', '-C', top, 'worktree', 'add', '-b', branch, path, base])
    if r.returncode:
        sys.exit(r.stderr.strip())
    if os.path.isdir(os.path.join(top, 'node_modules')):
        run(['cp', '-cR', os.path.join(top, 'node_modules'), os.path.join(path, 'node_modules')])
    if os.path.exists(os.path.join(top, '.env.local')):
        run(['cp', os.path.join(top, '.env.local'), os.path.join(path, '.env.local')])
    if os.environ.get('TUNED_NAME'):
        rp = os.path.join(state_dir(team_name()), 'reports.json')
        reports = read_json(rp, {})
        reports.setdefault(os.environ['TUNED_NAME'], {}).update(worktree=path, branch=branch)
        write_json(rp, reports)
    print(f'Worktree for {branch} (from {base}): {path}')


def report(args):
    kind = args[0] if args else ''
    if kind not in ('start', 'eta', 'done'):
        sys.exit('Usage: tunedteam report start "~15:00" "what" | eta "~16:00" | done "commit abc123"')
    name, team = me(), team_name()
    path = os.path.join(state_dir(team), 'reports.json')
    reports = read_json(path, {})
    r = reports.setdefault(name, {})
    rest = args[1:]
    if kind == 'start':
        r.update(eta=rest[0] if rest else '?', what=rest[1] if len(rest) > 1 else r.get('what', ''), done=False)
    elif kind == 'eta':
        r['eta'] = rest[0] if rest else '?'
    else:
        r.update(done=True, eta='', what=f'done: {rest[0]}' if rest else 'done')
    write_json(path, reports)
    print(f'report saved ({name}): {kind} {" ".join(rest)}'.strip())


def check(args):
    timeout = 0
    if args[:1] == ['--timeout']:
        timeout, args = int(args[1]), args[2:]
    running = lambda: len(run(['pgrep', '-fx', CHECK_PATTERN]).stdout.split())
    waited = 0
    while running() >= CHECK_SLOTS:
        if timeout and waited >= timeout:
            print(f'tunedteam check: still {running()} checks running after {waited} s (limit {CHECK_SLOTS}). '
                  'Nothing ran, do not merge; try again later.', file=sys.stderr)
            sys.exit(3)
        if waited % 60 == 0:
            print(f'tunedteam check: {running()} checks running (limit {CHECK_SLOTS}), waiting...', file=sys.stderr)
        time.sleep(15)
        waited += 15
    if args:
        os.execvp(args[0], args)


def close_all(force):
    team = team_name()
    top = repo_root(os.getcwd())
    base = run(['git', '-C', top, 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD']).stdout.strip().removeprefix('origin/') \
        or run(['git', '-C', top, 'branch', '--show-current']).stdout.strip()
    open_work = []
    if base:
        for b in run(['git', '-C', top, 'branch', '--format=%(refname:short)', '--no-merged', base]).stdout.split():
            open_work.append(f'branch {b}: not merged into {base}')
        for wt in re.findall(r'^worktree (.+)$', run(['git', '-C', top, 'worktree', 'list', '--porcelain']).stdout, re.M):
            if wt != top:
                open_work.append(f'worktree {wt}')
            changes = run(['git', '-C', wt, 'status', '--porcelain'] + (['--untracked-files=no'] if wt == top else [])).stdout
            if changes.strip():
                open_work.append(f'uncommitted files in {wt}: {len(changes.splitlines())}')
    if open_work and not force:
        print('Unmerged work, the team stays open:')
        print('\n'.join(f'  - {w}' for w in open_work))
        print("Close anyway? Only after the owner's yes: tunedteam close-all --force")
        sys.exit(1)
    print(f'Closing team {team}.')
    tmux('run-shell', '-b', f"sleep 3; {shlex.join(TMUX + ['kill-session', '-t', f'={team}'])}")


# ---------- scheduled commands (launchd: no tokens, survives a closed team and a restarted Mac) ----------

AGENTS_DIR = os.path.join(HOME, 'Library', 'LaunchAgents')
SCHEDULE_PREFIX = 'com.tunedteam.'


def job_label(name):
    return SCHEDULE_PREFIX + name


def job_log(name):
    return os.path.join(HOME, '.tunedteam', 'schedule', f'{name}.log')


def jobs():
    """{name: (plist path, on)} of the commands tunedteam scheduled; an "off" one keeps its file as .plist.off."""
    out = {}
    for f in sorted(glob.glob(os.path.join(AGENTS_DIR, SCHEDULE_PREFIX + '*.plist*'))):
        base = os.path.basename(f)
        if base.endswith('.plist') or base.endswith('.plist.off'):
            out[base[len(SCHEDULE_PREFIX):].split('.plist')[0]] = (f, base.endswith('.plist'))
    return out


def launchctl(*args):
    return run(['launchctl', *args])


def schedule_add(name, at, command):
    import plistlib
    if not re.fullmatch(r'[A-Za-z0-9_-]+', name):
        sys.exit('Name: letters, digits, - and _ only.')
    m = re.fullmatch(r'([01]?\d|2[0-3]):([0-5]\d)', at)
    if not m or not command:
        sys.exit('Usage: tunedteam schedule add NAME HH:MM COMMAND...')
    os.makedirs(AGENTS_DIR, exist_ok=True)
    os.makedirs(os.path.dirname(job_log(name)), exist_ok=True)
    path = os.path.join(AGENTS_DIR, job_label(name) + '.plist')
    if name in jobs():
        schedule_rm(name, quiet=True)
    # A login shell, so PATH (Homebrew) is the one you have in a terminal; a date line before every run.
    with open(path, 'wb') as f:
        plistlib.dump({'Label': job_label(name),
                       'ProgramArguments': ['/bin/zsh', '-lc', f'echo "== $(date)"; {command}'],
                       'StartCalendarInterval': {'Hour': int(m.group(1)), 'Minute': int(m.group(2))},
                       'StandardOutPath': job_log(name), 'StandardErrorPath': job_log(name),
                       'TunedteamCommand': command, 'TunedteamAt': f'{int(m.group(1)):02d}:{m.group(2)}'}, f)
    r = launchctl('bootstrap', f'gui/{os.getuid()}', path)
    if r.returncode:
        sys.exit(f'launchd refused it: {r.stderr.strip()}')
    print(f'{name}: every day at {int(m.group(1)):02d}:{m.group(2)}: {command}')


def schedule_rm(name, quiet=False):
    path, on = jobs().get(name, (None, False))
    if not path:
        sys.exit(f'No scheduled command "{name}".')
    if on:
        launchctl('bootout', f'gui/{os.getuid()}/{job_label(name)}')
    os.remove(path)
    if not quiet:
        print(f'{name}: removed.')


def schedule(args):
    sub, rest = (args[0], args[1:]) if args else ('list', [])
    if sub == 'add':
        return schedule_add(rest[0] if rest else '', rest[1] if len(rest) > 1 else '', ' '.join(rest[2:]))
    js = jobs()
    if sub != 'list':
        name = rest[0] if rest else ''
        if name not in js:
            sys.exit(f'No scheduled command "{name}". See: tunedteam schedule')
        path, on = js[name]
        if sub == 'rm':
            return schedule_rm(name)
        if sub == 'run':
            if not on:
                sys.exit(f'{name} is off: tunedteam schedule on {name}')
            launchctl('kickstart', f'gui/{os.getuid()}/{job_label(name)}')
            return print(f'{name}: started; output in tunedteam schedule log {name}')
        if sub == 'log':
            try:
                return print(''.join(open(job_log(name)).readlines()[-40:]), end='')
            except OSError:
                return print(f'{name}: no runs yet.')
        if sub in ('off', 'on') and on == (sub == 'off'):
            new = path[:-4] if sub == 'on' else path + '.off'
            if sub == 'off':
                launchctl('bootout', f'gui/{os.getuid()}/{job_label(name)}')
            os.rename(path, new)
            if sub == 'on':
                launchctl('bootstrap', f'gui/{os.getuid()}', new)
            return print(f'{name}: {sub}.')
        if sub in ('off', 'on'):
            return print(f'{name}: already {sub}.')
        sys.exit('Usage: tunedteam schedule [add NAME HH:MM COMMAND... | run|log|off|on|rm NAME]')
    if not js:
        return print('Nothing scheduled. Add: tunedteam schedule add NAME HH:MM COMMAND...')
    print('| Name | When | State | Last run | Exit | Command |')
    print('|---|---|---|---|---|---|')
    for name, (path, on) in js.items():
        p = read_plist(path)
        info = launchctl('print', f'gui/{os.getuid()}/{job_label(name)}').stdout if on else ''
        code = re.search(r'last exit code = (\d+)', info)
        try:
            last = time.strftime('%d.%m %H:%M', time.localtime(os.path.getmtime(job_log(name))))
        except OSError:
            last = 'never'
        print(f"| {name} | daily {p.get('TunedteamAt', '?')} | {'on' if on else 'off'} | {last} | "
              f"{code.group(1) if code else '–'} | {short(p.get('TunedteamCommand', ''), 50)} |")


def read_plist(path):
    import plistlib
    try:
        with open(path, 'rb') as f:
            return plistlib.load(f)
    except Exception:
        return {}


def claude_update_setup():
    """Once: offer to keep Claude Code up to date every morning, when it came from Homebrew."""
    path = os.path.join(HOME, '.tunedteam', 'claude-update.json')
    casks = [os.path.basename(c) for c in glob.glob('/opt/homebrew/Caskroom/claude-code*') + glob.glob('/usr/local/Caskroom/claude-code*')]
    if not casks or 'claude-update' in jobs() or read_json(path, {}).get('asked'):
        return
    pick = select('Update Claude Code every morning (Homebrew, in the background, no tokens)?',
                  [('yes', 'yes, every day at 07:00'), ('no', 'no')], 'yes')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_json(path, {'asked': True})
    if pick == 'yes':
        schedule_add('claude-update', '07:00', f'brew upgrade --cask {casks[0]}')


def teams():
    """The teams running on this Mac, each with its project and its director's address."""
    names = tmux('list-sessions', '-F', '#{session_name}').stdout.split()
    if not names:
        return print('No team is running.')
    mine = os.environ.get('TUNED_TEAM')
    for t in names:
        cwd = read_json(os.path.join(HOME, '.tunedteam', 'teams', t, 'config.json'), {}).get('cwd', '?')
        print(f"{address(t, 'director')}  {cwd.replace(HOME, '~')}" + ('  (your team)' if t == mine else ''))


# ---------- status table ----------

def claude_pid(pane_pid):
    """The claude process in a pane: the pane's own process or one of its children."""
    for pid in [pane_pid] + [int(p) for p in run(['pgrep', '-P', str(pane_pid)]).stdout.split()]:
        if os.path.exists(os.path.join(CLAUDE_DIR, 'sessions', f'{pid}.json')):
            return pid
    return None


def transcript(sid):
    """Last reply text, the tool call still waiting for its result (a permission prompt), context tokens, model."""
    files = glob.glob(os.path.join(CLAUDE_DIR, 'projects', '*', f'{sid}.jsonl'))
    last, pending, ctx, model = '', None, 0, ''
    if not files:
        return last, pending, ctx, model
    with open(max(files, key=os.path.getmtime), 'rb') as f:
        # Only the end matters (the last reply, the last tool call, the last usage), and transcripts grow to
        # tens of MB: read the last 256 KB. The first, cut line fails to parse and is skipped.
        f.seek(max(0, os.fstat(f.fileno()).st_size - 262144))
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            msg = r.get('message') or {}
            if r.get('type') == 'assistant':
                u = msg.get('usage') or {}
                if u:
                    ctx = u.get('input_tokens', 0) + u.get('cache_read_input_tokens', 0) + u.get('cache_creation_input_tokens', 0)
                model = msg.get('model', model)
                c = msg.get('content')
                if isinstance(c, list):
                    calls = [x for x in c if isinstance(x, dict) and x.get('type') == 'tool_use']
                    pending = calls[-1].get('name') if calls else pending
                    t = ' '.join(x.get('text', '') for x in c if isinstance(x, dict) and x.get('type') == 'text').strip()
                    last = t or last
            elif r.get('type') == 'user':
                pending = None
    return last, pending, ctx, model


def ctx_pct(tokens, model):
    window = 1_000_000 if 'opus' in model else 200_000
    return round(tokens * 100 / window)


def short(s, n):
    s = ' '.join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + '…'


def team_rows(team):
    """(index, window, branch, ctx, RAM, state, ETA, doing) for the director and every specialist."""
    reports = read_json(os.path.join(state_dir(team), 'reports.json'), {})
    rows = []
    for idx, name, pane in windows(team):
        if not re.fullmatch(r'director|specialist-\d+', name):
            continue  # the owner's shell and any tab the owner opened
        pid = claude_pid(pane)
        sess = read_json(os.path.join(CLAUDE_DIR, 'sessions', f'{pid}.json'), {}) if pid else {}
        last, pending, tokens, model = transcript(sess['sessionId']) if sess.get('sessionId') else ('', None, 0, '')
        rep = reports.get(name, {})
        if not pid:
            state = 'starting or stopped'
        elif name == os.environ.get('TUNED_NAME'):
            state = 'this window'
        elif sess.get('status') == 'waiting' and pending:
            state = f"waiting for the owner: {'question' if pending == 'AskUserQuestion' else pending.removeprefix('mcp__')}"
        elif sess.get('status') == 'busy':
            state = 'working'
        elif rep and not rep.get('done'):
            state = 'task open'
        else:
            state = 'free'
        role = 'talks to the owner' if name == 'director' else (rep.get('branch', '') if rep and not rep.get('done') else '')
        doing = rep.get('what', '') if rep else ''
        rss = run(['ps', '-o', 'rss=', '-p', str(pid)]).stdout.strip() if pid else ''
        ram = f'{int(rss) // 1024} MB' if rss.isdigit() else '–'
        rows.append((idx, name, role, f'{ctx_pct(tokens, model)}%' if tokens else '–', ram, state, rep.get('eta', ''), doing))
    return rows


def team_summary(rows):
    specs = [r for r in rows if r[1].startswith('specialist-')]
    count = lambda pred: sum(1 for r in specs if pred(r[5]))
    return (f"specialists: {count(lambda s: s in ('working', 'task open'))} working · "
            f"{count(lambda s: s.startswith('waiting'))} waiting for the owner · {count(lambda s: s == 'free')} free")


def tasks():
    """The tasks in progress, each with the specialists on it: from their reports and their live state."""
    team = team_name()
    groups, free = {}, []
    for idx, name, branch, ctx, ram, state, eta, doing in team_rows(team):
        if not name.startswith('specialist-'):
            continue
        if state in ('free', 'starting or stopped'):
            free.append(name)
            continue
        g = groups.setdefault(doing or f'(no report from {name})', {'agents': [], 'branches': set(), 'etas': [], 'states': []})
        g['agents'].append(name)
        g['branches'].update([branch] if branch else [])
        g['etas'].append(eta)
        g['states'].append(state)
    print(f"{team} · {time.strftime('%H:%M')} · tasks in progress: {len(groups)}")
    print()
    print('| Task | Specialists | Branch | ETA | State |')
    print('|---|---|---|---|---|')
    for what, g in groups.items():
        states = sorted(set(g['states']), key=lambda s: not s.startswith('waiting'))  # waiting for the owner first
        print(f"| {short(what, 60)} | {', '.join(g['agents'])} | {', '.join(sorted(g['branches']))} | "
              f"{max((e for e in g['etas'] if e), default='')} | {short('; '.join(states), 40)} |")
    print(f"\nFree: {', '.join(free) if free else 'nobody'}")


def status():
    team = team_name()
    rows = team_rows(team)
    print(f"{team} · {time.strftime('%H:%M')} · {team_summary(rows)}")
    print()
    print('| # | Window | Branch | Ctx | RAM | State | ETA | Doing |')
    print('|---|---|---|---|---|---|---|---|')
    for idx, name, role, ctx, ram, state, eta, doing in rows:
        print(f'| {idx} | {name} | {role} | {ctx} | {ram} | {short(state, 40)} | {short(eta, 12)} | {short(doing, 48)} |')
    total = sum(int(r[4].split()[0]) for r in rows if r[4] != '–')
    print(f'\nRAM of all windows: {total / 1024:.1f} GB')


# ---------- hooks ----------

def statusline():
    d = json.loads(sys.stdin.read() or '{}')
    cwd = (d.get('workspace') or {}).get('current_dir') or d.get('cwd') or os.getcwd()
    model = (d.get('model') or {}).get('display_name', '')
    # One git call for both the repo (main checkout, also from a worktree) and the branch.
    git = run(['git', '-C', cwd, '--no-optional-locks', 'rev-parse', '--path-format=absolute',
               '--git-common-dir', '--abbrev-ref', 'HEAD']).stdout.split('\n')
    repo = os.path.dirname(os.path.realpath(git[0])) if git[0] else cwd
    branch = git[1] if len(git) > 1 and git[1] != 'HEAD' else ''
    cw = d.get('context_window') or {}
    u = cw.get('current_usage') or {}
    tokens = u.get('input_tokens', 0) + u.get('cache_read_input_tokens', 0) + u.get('cache_creation_input_tokens', 0)
    pct = ctx_pct(tokens, (d.get('model') or {}).get('id', '')) if tokens else (
        round(cw['used_percentage']) if cw.get('used_percentage') is not None else None)
    name = os.environ.get('TUNED_NAME')
    # The context colour warns before the role's restart point (director ~20%, specialists ~30%).
    limit = 20 if name == 'director' else 30
    ctx = '' if pct is None else paint(GREEN if pct < limit - 5 else YELLOW if pct < limit else RED, f'ctx {pct}%')
    out = SEP.join(x for x in (paint(BOLD, os.path.basename(repo)) + (' ' + paint(MAGENTA, branch) if branch else ''),
                               paint(DIM, model) if model else '', ctx) if x)
    if name == 'director':
        # The window the owner talks to: what to say on the left, the team and the owner's own line, with the
        # usual line and the version pushed to the right edge.
        team = team_name()
        width = int(os.environ.get('COLUMNS') or 0)
        team_line = SEP.join(x for x in (cached(team, 'team', 15, lambda: team_counts(team_rows(team))),
                                         own_status(team)) if x)
        print(spread(HINTS, paint(DIM, cached(team, 'version', 60, version_line)), width, drop=True))
        print(spread(team_line, out, width))
    else:
        print(out)


# ANSI colours from the terminal's own palette, so they follow its theme.
BOLD, DIM, GREEN, YELLOW, RED, MAGENTA, CYAN = '1', '2', '32', '33', '31', '35', '36'
ANSI = re.compile(r'\x1b\[[0-9;]*m')


def paint(code, text):
    return f'\x1b[{code}m{text}\x1b[0m'


SEP = paint(DIM, ' │ ')


def spread(left, right, width, drop=False):
    """left and right on one line, right at the edge. Claude Code strips leading spaces and indents the line
    by 2, so the gap goes in the middle. Without room, right is dropped (drop) or gets a line of its own."""
    gap = width - 4 - len(ANSI.sub('', left)) - len(ANSI.sub('', right))
    if width and gap >= 3:
        return left + ' ' * gap + right
    if drop:
        return left
    return f'{left}\n{right}' if width else left + SEP + right


def team_counts(rows):
    """The short team line: who works, who is free, and who waits for the owner when anyone does."""
    states = [r[5] for r in rows if r[1].startswith('specialist-')]
    waiting = sum(s.startswith('waiting') for s in states)
    return '  '.join([paint(GREEN, f"● {sum(s in ('working', 'task open') for s in states)} working"),
                      paint(DIM, f"○ {states.count('free')} free")]
                     + ([paint(BOLD + ';' + YELLOW, f'▲ {waiting} WAITING FOR YOU')] if waiting else []))


HINTS = (paint(DIM, 'say ') + paint(DIM, ' · ').join(paint(CYAN, x) for x in
                                                     ('tasks', 'status', 'add a specialist', 'release', 'close the team'))
         + SEP + paint(BOLD, 'Ctrl+V') + paint(DIM, ' image') + SEP + paint(BOLD, '!cmd') + paint(DIM, ' run here'))


def version_line():
    """tunedteam and its version, plus a newer one seen by the daily check (no network here)."""
    latest = read_json(os.path.join(HOME, '.tunedteam', 'update-check.json'), {}).get('latest', '')
    mine = version().split()[0]
    try:
        newer = tuple(map(int, latest.split('.'))) > tuple(map(int, mine.split('.')))
    except ValueError:
        newer = False
    return f'tunedteam {version()}' + (f' ({latest} available)' if newer else '')


def cached(team, key, seconds, compute):
    """compute() at most once per `seconds`: the status line runs after every message."""
    path = os.path.join(state_dir(team), f'statusline-{key}.json')
    c = read_json(path, {})
    if time.time() - c.get('at', 0) > seconds:
        c = {'at': time.time(), 'text': compute()}
        write_json(path, c)
    return c.get('text', '')


def own_status(team):
    """The first line of the owner's own command (~/.tunedteam/statusline, e.g. deploys on Vercel), run in the
    project folder in the background every 5 minutes, so a slow command never holds up the window."""
    try:
        command = open(os.path.join(HOME, '.tunedteam', 'statusline')).read().strip()
    except OSError:
        return ''
    if not command:
        return ''
    out = os.path.join(state_dir(team), 'statusline-own.txt')
    stamp = out + '.at'
    try:
        stale = time.time() - os.path.getmtime(stamp) > 300
    except OSError:
        stale = True
    if stale:
        open(stamp, 'w').close()  # before the run starts, so the next refresh does not start another one
        subprocess.Popen(['sh', '-c', f'({command}) > {shlex.quote(out)}.tmp 2>/dev/null; mv {shlex.quote(out)}.tmp {shlex.quote(out)}'],
                         cwd=config(team).get('cwd') or None, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    try:
        return short(open(out).readline(), 100)
    except OSError:
        return ''


def speak():
    d = json.loads(sys.stdin.read() or '{}')
    if d.get('hook_event_name') == 'Notification':
        text = WAIT.format(name=os.environ.get('TUNED_NAME', 'Claude').replace('-', ' '))
    else:
        text = '\n'.join(re.findall(r'<speak>(.*?)</speak>', d.get('last_assistant_message') or '', re.S))
    if text.strip():
        subprocess.Popen(['say', *voice(text), text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else ''
    if cmd == '':
        start()
    elif cmd in ('--inside-out', 'inside-out'):
        print(open(os.path.join(ROOT, 'INSIDE-OUT.md')).read(), end='')
    elif cmd in ('--version', '-v', 'version'):
        print(f'tunedteam {version()}')
        notice = update_notice()
        if notice:
            print(notice)
    elif cmd == 'status':
        status()
    elif cmd == 'teams':
        teams()
    elif cmd == 'tasks':
        tasks()
    elif cmd == 'schedule':
        schedule(a[1:])
    elif cmd == 'report':
        report(a[1:])
    elif cmd == 'worktree':
        worktree(a[1:])
    elif cmd == 'check':
        check(a[1:])
    elif cmd == 'done':
        done()
    elif cmd == 'add':
        add()
    elif cmd == 'restart' and len(a) > 1:
        restart(a[1])
    elif cmd == 'close-all':
        close_all('--force' in a)
    elif cmd == 'statusline':
        statusline()
    elif cmd == 'speak':
        speak()
    else:
        sys.exit(__doc__)


if __name__ == '__main__':
    main()
