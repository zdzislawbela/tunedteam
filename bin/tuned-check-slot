#!/bin/sh
# Waits for a free slot for the project's full check: at most 2 run at a time
# across the team (shared machine, team rules). Never lets a check through
# without a free slot: after --timeout it exits 3 and runs nothing.
#
#   tuned-check-slot npm run check                       wait, then run the check
#   tuned-check-slot sh scripts/merge-to-main.sh <br>    wait, then merge (it reruns the check)
#   tuned-check-slot --timeout 540 npm run check         give up after 540 s (exit 3)
#   tuned-check-slot                                     only wait, run nothing
#
# A running check is a process whose whole command line is "npm run check"
# (pgrep -x, so this script and the shell that called it never count).
# TUNED_CHECK_MAX and TUNED_CHECK_PATTERN change the limit and the pattern.
set -u
max=${TUNED_CHECK_MAX:-2}
pattern=${TUNED_CHECK_PATTERN:-npm run check}
timeout=0
if [ "${1:-}" = "--timeout" ]; then
  timeout=${2:?--timeout needs seconds}
  shift 2
fi

running() { pgrep -fx "$pattern" | wc -l | tr -d ' '; }

waited=0
while [ "$(running)" -ge "$max" ]; do
  if [ "$timeout" -gt 0 ] && [ "$waited" -ge "$timeout" ]; then
    echo "tuned-check-slot: still $(running) checks running after ${waited}s (limit $max). Nothing run, do not merge; try again later." >&2
    exit 3
  fi
  [ $((waited % 60)) -eq 0 ] && echo "tuned-check-slot: $(running) checks running (limit $max), waiting..." >&2
  sleep 15
  waited=$((waited + 15))
done

[ $# -eq 0 ] && exit 0
exec "$@"
