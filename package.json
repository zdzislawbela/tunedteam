{
  "name": "tuned-team",
  "displayName": "Tuned Team",
  "description": "A team of Claude Code agents in one window: manager, deputy and colleagues, each with its own role",
  "version": "0.1.19",
  "publisher": "tuned",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zdzislawbela/tuned-team.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tunedTeam.start",
        "title": "Tuned Team: start"
      },
      {
        "command": "tunedTeam.add",
        "title": "Tuned Team: add colleague"
      },
      {
        "command": "tunedTeam.label",
        "title": "Tuned Team: label tabs with numbers"
      },
      {
        "command": "tunedTeam.control",
        "title": "Tuned Team: control mode"
      }
    ]
  }
}
